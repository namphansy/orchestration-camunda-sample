<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_OrderProcessingExternal"
                  targetNamespace="http://example.com/workflow/order/external">
  <bpmn:error id="Error_InsufficientStockExternal" name="Insufficient Stock" errorCode="INSUFFICIENT_STOCK" />
  <bpmn:error id="Error_PaymentDeclinedExternal" name="Payment Declined" errorCode="PAYMENT_DECLINED" />
  <bpmn:error id="Error_ShipmentFailedExternal" name="Shipment Failed" errorCode="SHIPMENT_FAILED" />

  <bpmn:process id="order-processing-external" name="Order Processing External Tasks" isExecutable="true">
    <bpmn:startEvent id="StartOrderExternal" name="Start Order">
      <bpmn:outgoing>Flow_Start_ValidateExternal</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ValidateOrderExternal" name="Validate Order" camunda:delegateExpression="${validateOrderDelegate}">
      <bpmn:incoming>Flow_Start_ValidateExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_ReserveExternal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ReserveInventoryExternal" name="Reserve Inventory Lines" camunda:type="external" camunda:topic="reserve-inventory">
      <bpmn:incoming>Flow_Validate_ReserveExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserve_PaymentExternal</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${orderLines}" camunda:elementVariable="orderLine" />
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="InsufficientStockBoundaryExternal" name="Insufficient Stock" attachedToRef="ReserveInventoryExternal">
      <bpmn:outgoing>Flow_InventoryError_CompensateExternal</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_InsufficientStockExternal" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="PaymentCallActivityExternal" name="Payment" calledElement="payment-subprocess-external" camunda:businessKey="${businessKey}">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reserve_PaymentExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_ResultExternal</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="PaymentDeclinedBoundaryExternal" name="Payment Declined" attachedToRef="PaymentCallActivityExternal">
      <bpmn:outgoing>Flow_PaymentDeclined_CompensateExternal</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_PaymentDeclinedExternal" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="PaymentResultGatewayExternal" name="Payment Charged?" default="Flow_PaymentNotCharged_CompensateExternal">
      <bpmn:incoming>Flow_Payment_ResultExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentCharged_DetermineApprovalExternal</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentNotCharged_CompensateExternal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="DetermineApprovalRequirementExternal" name="Determine Approval Requirement" camunda:resultVariable="approvalLevel" camunda:decisionRef="order-approval" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_PaymentCharged_DetermineApprovalExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_DetermineApproval_ApprovalGatewayExternal</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="ApprovalGatewayExternal" name="Approval Required?" default="Flow_NoApproval_MergeExternal">
      <bpmn:incoming>Flow_DetermineApproval_ApprovalGatewayExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_NoApproval_MergeExternal</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManagerApproval_TaskExternal</bpmn:outgoing>
      <bpmn:outgoing>Flow_DirectorApproval_TaskExternal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ManagerApprovalTaskExternal" name="Manager Approval" camunda:candidateGroups="managers">
      <bpmn:incoming>Flow_ManagerApproval_TaskExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerApproval_DecisionExternal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DirectorApprovalTaskExternal" name="Director Approval" camunda:candidateGroups="directors">
      <bpmn:incoming>Flow_DirectorApproval_TaskExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_DirectorApproval_DecisionExternal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ApprovalDecisionGatewayExternal" name="Approved?" default="Flow_ApprovalRejected_CompensateExternal">
      <bpmn:incoming>Flow_ManagerApproval_DecisionExternal</bpmn:incoming>
      <bpmn:incoming>Flow_DirectorApproval_DecisionExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalAccepted_MergeExternal</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalRejected_CompensateExternal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ApprovalMergeGatewayExternal" name="Approval Complete">
      <bpmn:incoming>Flow_NoApproval_MergeExternal</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovalAccepted_MergeExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalMerge_ShippingExternal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="ShippingCallActivityExternal" name="Shipping" calledElement="shipping-subprocess-external" camunda:businessKey="${businessKey}">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovalMerge_ShippingExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_Shipping_NotificationExternal</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="ShipmentFailedBoundaryExternal" name="Shipment Failed" attachedToRef="ShippingCallActivityExternal">
      <bpmn:outgoing>Flow_ShipmentFailed_CompensateExternal</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_ShipmentFailedExternal" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="NotificationCallActivityExternal" name="Invoice and Notification" calledElement="notification-subprocess" camunda:businessKey="${businessKey}">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Shipping_NotificationExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_Notification_CompleteExternal</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="CompleteOrderExternal" name="Complete Order" camunda:delegateExpression="${completeOrderDelegate}">
      <bpmn:incoming>Flow_Notification_CompleteExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_EndExternal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OrderCompletedExternal" name="Order Completed">
      <bpmn:incoming>Flow_Complete_EndExternal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CompensateOrderExternal" name="Compensate Order" camunda:delegateExpression="${compensateOrderDelegate}">
      <bpmn:incoming>Flow_InventoryError_CompensateExternal</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentDeclined_CompensateExternal</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentNotCharged_CompensateExternal</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovalRejected_CompensateExternal</bpmn:incoming>
      <bpmn:incoming>Flow_ShipmentFailed_CompensateExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_Compensate_RejectExternal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RejectOrderExternal" name="Reject Order" camunda:delegateExpression="${rejectOrderDelegate}">
      <bpmn:incoming>Flow_Compensate_RejectExternal</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_EndExternal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OrderRejectedExternal" name="Order Rejected">
      <bpmn:incoming>Flow_Reject_EndExternal</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_ValidateExternal" sourceRef="StartOrderExternal" targetRef="ValidateOrderExternal" />
    <bpmn:sequenceFlow id="Flow_Validate_ReserveExternal" sourceRef="ValidateOrderExternal" targetRef="ReserveInventoryExternal" />
    <bpmn:sequenceFlow id="Flow_Reserve_PaymentExternal" sourceRef="ReserveInventoryExternal" targetRef="PaymentCallActivityExternal" />
    <bpmn:sequenceFlow id="Flow_Payment_ResultExternal" sourceRef="PaymentCallActivityExternal" targetRef="PaymentResultGatewayExternal" />
    <bpmn:sequenceFlow id="Flow_PaymentCharged_DetermineApprovalExternal" name="Charged" sourceRef="PaymentResultGatewayExternal" targetRef="DetermineApprovalRequirementExternal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentStatus == 'CHARGED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentNotCharged_CompensateExternal" sourceRef="PaymentResultGatewayExternal" targetRef="CompensateOrderExternal" />
    <bpmn:sequenceFlow id="Flow_DetermineApproval_ApprovalGatewayExternal" sourceRef="DetermineApprovalRequirementExternal" targetRef="ApprovalGatewayExternal" />
    <bpmn:sequenceFlow id="Flow_NoApproval_MergeExternal" sourceRef="ApprovalGatewayExternal" targetRef="ApprovalMergeGatewayExternal" />
    <bpmn:sequenceFlow id="Flow_ManagerApproval_TaskExternal" sourceRef="ApprovalGatewayExternal" targetRef="ManagerApprovalTaskExternal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalLevel == 'MANAGER'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DirectorApproval_TaskExternal" sourceRef="ApprovalGatewayExternal" targetRef="DirectorApprovalTaskExternal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalLevel == 'DIRECTOR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerApproval_DecisionExternal" sourceRef="ManagerApprovalTaskExternal" targetRef="ApprovalDecisionGatewayExternal" />
    <bpmn:sequenceFlow id="Flow_DirectorApproval_DecisionExternal" sourceRef="DirectorApprovalTaskExternal" targetRef="ApprovalDecisionGatewayExternal" />
    <bpmn:sequenceFlow id="Flow_ApprovalAccepted_MergeExternal" sourceRef="ApprovalDecisionGatewayExternal" targetRef="ApprovalMergeGatewayExternal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApprovalRejected_CompensateExternal" sourceRef="ApprovalDecisionGatewayExternal" targetRef="CompensateOrderExternal" />
    <bpmn:sequenceFlow id="Flow_ApprovalMerge_ShippingExternal" sourceRef="ApprovalMergeGatewayExternal" targetRef="ShippingCallActivityExternal" />
    <bpmn:sequenceFlow id="Flow_Shipping_NotificationExternal" sourceRef="ShippingCallActivityExternal" targetRef="NotificationCallActivityExternal" />
    <bpmn:sequenceFlow id="Flow_Notification_CompleteExternal" sourceRef="NotificationCallActivityExternal" targetRef="CompleteOrderExternal" />
    <bpmn:sequenceFlow id="Flow_Complete_EndExternal" sourceRef="CompleteOrderExternal" targetRef="OrderCompletedExternal" />
    <bpmn:sequenceFlow id="Flow_InventoryError_CompensateExternal" sourceRef="InsufficientStockBoundaryExternal" targetRef="CompensateOrderExternal" />
    <bpmn:sequenceFlow id="Flow_PaymentDeclined_CompensateExternal" sourceRef="PaymentDeclinedBoundaryExternal" targetRef="CompensateOrderExternal" />
    <bpmn:sequenceFlow id="Flow_ShipmentFailed_CompensateExternal" sourceRef="ShipmentFailedBoundaryExternal" targetRef="CompensateOrderExternal" />
    <bpmn:sequenceFlow id="Flow_Compensate_RejectExternal" sourceRef="CompensateOrderExternal" targetRef="RejectOrderExternal" />
    <bpmn:sequenceFlow id="Flow_Reject_EndExternal" sourceRef="RejectOrderExternal" targetRef="OrderRejectedExternal" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderProcessingExternal">
    <bpmndi:BPMNPlane id="BPMNPlane_OrderProcessingExternal" bpmnElement="order-processing-external">
      <bpmndi:BPMNShape id="StartOrderExternal_di" bpmnElement="StartOrderExternal">
        <dc:Bounds x="160" y="260" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidateOrderExternal_di" bpmnElement="ValidateOrderExternal">
        <dc:Bounds x="250" y="238" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReserveInventoryExternal_di" bpmnElement="ReserveInventoryExternal">
        <dc:Bounds x="420" y="238" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InsufficientStockBoundaryExternal_di" bpmnElement="InsufficientStockBoundaryExternal">
        <dc:Bounds x="482" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentCallActivityExternal_di" bpmnElement="PaymentCallActivityExternal">
        <dc:Bounds x="610" y="238" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentDeclinedBoundaryExternal_di" bpmnElement="PaymentDeclinedBoundaryExternal">
        <dc:Bounds x="657" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentResultGatewayExternal_di" bpmnElement="PaymentResultGatewayExternal" isMarkerVisible="true">
        <dc:Bounds x="800" y="253" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DetermineApprovalRequirementExternal_di" bpmnElement="DetermineApprovalRequirementExternal">
        <dc:Bounds x="900" y="238" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalGatewayExternal_di" bpmnElement="ApprovalGatewayExternal" isMarkerVisible="true">
        <dc:Bounds x="1110" y="253" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManagerApprovalTaskExternal_di" bpmnElement="ManagerApprovalTaskExternal">
        <dc:Bounds x="1220" y="170" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DirectorApprovalTaskExternal_di" bpmnElement="DirectorApprovalTaskExternal">
        <dc:Bounds x="1220" y="335" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalDecisionGatewayExternal_di" bpmnElement="ApprovalDecisionGatewayExternal" isMarkerVisible="true">
        <dc:Bounds x="1410" y="253" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalMergeGatewayExternal_di" bpmnElement="ApprovalMergeGatewayExternal" isMarkerVisible="true">
        <dc:Bounds x="1505" y="115" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShippingCallActivityExternal_di" bpmnElement="ShippingCallActivityExternal">
        <dc:Bounds x="1625" y="238" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShipmentFailedBoundaryExternal_di" bpmnElement="ShipmentFailedBoundaryExternal">
        <dc:Bounds x="1672" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotificationCallActivityExternal_di" bpmnElement="NotificationCallActivityExternal">
        <dc:Bounds x="1815" y="238" width="155" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompleteOrderExternal_di" bpmnElement="CompleteOrderExternal">
        <dc:Bounds x="2030" y="238" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderCompletedExternal_di" bpmnElement="OrderCompletedExternal">
        <dc:Bounds x="2210" y="260" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompensateOrderExternal_di" bpmnElement="CompensateOrderExternal">
        <dc:Bounds x="900" y="485" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RejectOrderExternal_di" bpmnElement="RejectOrderExternal">
        <dc:Bounds x="1110" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderRejectedExternal_di" bpmnElement="OrderRejectedExternal">
        <dc:Bounds x="1147" y="752" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_ValidateExternal_di" bpmnElement="Flow_Start_ValidateExternal">
        <di:waypoint x="196" y="278" />
        <di:waypoint x="250" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_ReserveExternal_di" bpmnElement="Flow_Validate_ReserveExternal">
        <di:waypoint x="370" y="278" />
        <di:waypoint x="420" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reserve_PaymentExternal_di" bpmnElement="Flow_Reserve_PaymentExternal">
        <di:waypoint x="560" y="278" />
        <di:waypoint x="610" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Payment_ResultExternal_di" bpmnElement="Flow_Payment_ResultExternal">
        <di:waypoint x="740" y="278" />
        <di:waypoint x="800" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentCharged_DetermineApprovalExternal_di" bpmnElement="Flow_PaymentCharged_DetermineApprovalExternal">
        <di:waypoint x="850" y="278" />
        <di:waypoint x="900" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentNotCharged_CompensateExternal_di" bpmnElement="Flow_PaymentNotCharged_CompensateExternal">
        <di:waypoint x="825" y="303" />
        <di:waypoint x="825" y="525" />
        <di:waypoint x="900" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DetermineApproval_ApprovalGatewayExternal_di" bpmnElement="Flow_DetermineApproval_ApprovalGatewayExternal">
        <di:waypoint x="1050" y="278" />
        <di:waypoint x="1110" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoApproval_MergeExternal_di" bpmnElement="Flow_NoApproval_MergeExternal">
        <di:waypoint x="1135" y="253" />
        <di:waypoint x="1135" y="140" />
        <di:waypoint x="1505" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerApproval_TaskExternal_di" bpmnElement="Flow_ManagerApproval_TaskExternal">
        <di:waypoint x="1135" y="253" />
        <di:waypoint x="1135" y="210" />
        <di:waypoint x="1220" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DirectorApproval_TaskExternal_di" bpmnElement="Flow_DirectorApproval_TaskExternal">
        <di:waypoint x="1135" y="303" />
        <di:waypoint x="1135" y="375" />
        <di:waypoint x="1220" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerApproval_DecisionExternal_di" bpmnElement="Flow_ManagerApproval_DecisionExternal">
        <di:waypoint x="1350" y="210" />
        <di:waypoint x="1435" y="210" />
        <di:waypoint x="1435" y="253" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DirectorApproval_DecisionExternal_di" bpmnElement="Flow_DirectorApproval_DecisionExternal">
        <di:waypoint x="1350" y="375" />
        <di:waypoint x="1435" y="375" />
        <di:waypoint x="1435" y="303" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalAccepted_MergeExternal_di" bpmnElement="Flow_ApprovalAccepted_MergeExternal">
        <di:waypoint x="1460" y="278" />
        <di:waypoint x="1490" y="278" />
        <di:waypoint x="1490" y="140" />
        <di:waypoint x="1505" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalRejected_CompensateExternal_di" bpmnElement="Flow_ApprovalRejected_CompensateExternal">
        <di:waypoint x="1435" y="303" />
        <di:waypoint x="1435" y="450" />
        <di:waypoint x="970" y="450" />
        <di:waypoint x="970" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalMerge_ShippingExternal_di" bpmnElement="Flow_ApprovalMerge_ShippingExternal">
        <di:waypoint x="1530" y="165" />
        <di:waypoint x="1530" y="278" />
        <di:waypoint x="1625" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Shipping_NotificationExternal_di" bpmnElement="Flow_Shipping_NotificationExternal">
        <di:waypoint x="1755" y="278" />
        <di:waypoint x="1815" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notification_CompleteExternal_di" bpmnElement="Flow_Notification_CompleteExternal">
        <di:waypoint x="1970" y="278" />
        <di:waypoint x="2030" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Complete_EndExternal_di" bpmnElement="Flow_Complete_EndExternal">
        <di:waypoint x="2150" y="278" />
        <di:waypoint x="2210" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InventoryError_CompensateExternal_di" bpmnElement="Flow_InventoryError_CompensateExternal">
        <di:waypoint x="500" y="336" />
        <di:waypoint x="500" y="525" />
        <di:waypoint x="900" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentDeclined_CompensateExternal_di" bpmnElement="Flow_PaymentDeclined_CompensateExternal">
        <di:waypoint x="675" y="336" />
        <di:waypoint x="675" y="525" />
        <di:waypoint x="900" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ShipmentFailed_CompensateExternal_di" bpmnElement="Flow_ShipmentFailed_CompensateExternal">
        <di:waypoint x="1690" y="336" />
        <di:waypoint x="1690" y="525" />
        <di:waypoint x="1040" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Compensate_RejectExternal_di" bpmnElement="Flow_Compensate_RejectExternal">
        <di:waypoint x="970" y="565" />
        <di:waypoint x="970" y="640" />
        <di:waypoint x="1110" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reject_EndExternal_di" bpmnElement="Flow_Reject_EndExternal">
        <di:waypoint x="1165" y="680" />
        <di:waypoint x="1165" y="752" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
