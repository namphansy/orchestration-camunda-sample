<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_ShippingSubprocess"
                  targetNamespace="http://example.com/workflow/shipping"
                  exporter="Camunda Modeler"
                  exporterVersion="5.49.0">
  <bpmn:error id="Error_ShipmentFailed" name="Shipment Failed" errorCode="SHIPMENT_FAILED" />

  <bpmn:process id="shipping-subprocess" name="Shipping Subprocess" isExecutable="true">
    <bpmn:startEvent id="StartShipping" name="Start Shipping">
      <bpmn:outgoing>Flow_Start_CreateShipment</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CreateShipment" name="Create Shipment" camunda:delegateExpression="${createShipmentDelegate}">
      <bpmn:incoming>Flow_Start_CreateShipment</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateShipment_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ShippingCompleted" name="Shipping Completed">
      <bpmn:incoming>Flow_CreateShipment_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_CreateShipment" sourceRef="StartShipping" targetRef="CreateShipment" />
    <bpmn:sequenceFlow id="Flow_CreateShipment_End" sourceRef="CreateShipment" targetRef="ShippingCompleted" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ShippingSubprocess">
    <bpmndi:BPMNPlane id="BPMNPlane_ShippingSubprocess" bpmnElement="shipping-subprocess">
      <bpmndi:BPMNShape id="StartShipping_di" bpmnElement="StartShipping">
        <dc:Bounds x="160" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CreateShipment_di" bpmnElement="CreateShipment">
        <dc:Bounds x="250" y="138" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShippingCompleted_di" bpmnElement="ShippingCompleted">
        <dc:Bounds x="450" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_CreateShipment_di" bpmnElement="Flow_Start_CreateShipment">
        <di:waypoint x="196" y="178" />
        <di:waypoint x="250" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CreateShipment_End_di" bpmnElement="Flow_CreateShipment_End">
        <di:waypoint x="390" y="178" />
        <di:waypoint x="450" y="178" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>