<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OrderProcessing" targetNamespace="http://example.com/workflow/order" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:error id="Error_InsufficientStock" name="Insufficient Stock" errorCode="INSUFFICIENT_STOCK" />
  <bpmn:error id="Error_PaymentDeclined" name="Payment Declined" errorCode="PAYMENT_DECLINED" />
  <bpmn:error id="Error_ShipmentFailed" name="Shipment Failed" errorCode="SHIPMENT_FAILED" />
  <bpmn:process id="order-processing" name="Order Processing" isExecutable="true">
    <bpmn:startEvent id="StartOrder" name="Start Order">
      <bpmn:outgoing>Flow_Start_Validate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ValidateOrder" name="Validate Order" camunda:delegateExpression="${validateOrderDelegate}">
      <bpmn:incoming>Flow_Start_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Reserve</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ReserveInventory" name="Reserve Inventory Lines" camunda:delegateExpression="${reserveInventoryDelegate}">
      <bpmn:incoming>Flow_Validate_Reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserve_Payment</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${orderLines}" camunda:elementVariable="orderLine" />
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="InsufficientStockBoundary" name="Insufficient Stock" attachedToRef="ReserveInventory">
      <bpmn:outgoing>Flow_InventoryError_Compensate</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_InsufficientStock" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="PaymentCallActivity" name="Payment" calledElement="payment-subprocess" camunda:businessKey="${businessKey}">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reserve_Payment</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_Result</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="PaymentDeclinedBoundary" name="Payment Declined" attachedToRef="PaymentCallActivity">
      <bpmn:outgoing>Flow_PaymentDeclined_Compensate</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_PaymentDeclined" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="PaymentResultGateway" name="Payment Charged?" default="Flow_PaymentNotCharged_Compensate">
      <bpmn:incoming>Flow_Payment_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentCharged_DetermineApproval</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentNotCharged_Compensate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="DetermineApprovalRequirement" name="Determine Approval Requirement" camunda:resultVariable="approvalLevel" camunda:decisionRef="order-approval" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_PaymentCharged_DetermineApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_DetermineApproval_ApprovalGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="ApprovalGateway" name="Approval Required?" default="Flow_NoApproval_Merge">
      <bpmn:incoming>Flow_DetermineApproval_ApprovalGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_NoApproval_Merge</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManagerApproval_Task</bpmn:outgoing>
      <bpmn:outgoing>Flow_DirectorApproval_Task</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ManagerApprovalTask" name="Manager Approval" camunda:candidateGroups="managers">
      <bpmn:incoming>Flow_ManagerApproval_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerApproval_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DirectorApprovalTask" name="Director Approval" camunda:candidateGroups="directors">
      <bpmn:incoming>Flow_DirectorApproval_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_DirectorApproval_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ApprovalDecisionGateway" name="Approved?" default="Flow_ApprovalRejected_Compensate">
      <bpmn:incoming>Flow_ManagerApproval_Decision</bpmn:incoming>
      <bpmn:incoming>Flow_DirectorApproval_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalAccepted_Merge</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalRejected_Compensate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ApprovalMergeGateway" name="Approval Complete">
      <bpmn:incoming>Flow_NoApproval_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovalAccepted_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalMerge_Shipping</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="ShippingCallActivity" name="Shipping" calledElement="shipping-subprocess" camunda:businessKey="${businessKey}">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovalMerge_Shipping</bpmn:incoming>
      <bpmn:outgoing>Flow_Shipping_Notification</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="ShipmentFailedBoundary" name="Shipment Failed" attachedToRef="ShippingCallActivity">
      <bpmn:outgoing>Flow_ShipmentFailed_Compensate</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_ShipmentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="NotificationCallActivity" name="Invoice and Notification" calledElement="notification-subprocess" camunda:businessKey="${businessKey}">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Shipping_Notification</bpmn:incoming>
      <bpmn:outgoing>Flow_Notification_Complete</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="CompleteOrder" name="Complete Order" camunda:delegateExpression="${completeOrderDelegate}">
      <bpmn:incoming>Flow_Notification_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OrderCompleted" name="Order Completed">
      <bpmn:incoming>Flow_Complete_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CompensateOrder" name="Compensate Order" camunda:delegateExpression="${compensateOrderDelegate}">
      <bpmn:incoming>Flow_InventoryError_Compensate</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentDeclined_Compensate</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentNotCharged_Compensate</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovalRejected_Compensate</bpmn:incoming>
      <bpmn:incoming>Flow_ShipmentFailed_Compensate</bpmn:incoming>
      <bpmn:outgoing>Flow_Compensate_Reject</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RejectOrder" name="Reject Order" camunda:delegateExpression="${rejectOrderDelegate}">
      <bpmn:incoming>Flow_Compensate_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OrderRejected" name="Order Rejected">
      <bpmn:incoming>Flow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="StartOrder" targetRef="ValidateOrder" />
    <bpmn:sequenceFlow id="Flow_Validate_Reserve" sourceRef="ValidateOrder" targetRef="ReserveInventory" />
    <bpmn:sequenceFlow id="Flow_Reserve_Payment" sourceRef="ReserveInventory" targetRef="PaymentCallActivity" />
    <bpmn:sequenceFlow id="Flow_Payment_Result" sourceRef="PaymentCallActivity" targetRef="PaymentResultGateway" />
    <bpmn:sequenceFlow id="Flow_PaymentCharged_DetermineApproval" name="Charged" sourceRef="PaymentResultGateway" targetRef="DetermineApprovalRequirement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentStatus == 'CHARGED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentNotCharged_Compensate" sourceRef="PaymentResultGateway" targetRef="CompensateOrder" />
    <bpmn:sequenceFlow id="Flow_DetermineApproval_ApprovalGateway" sourceRef="DetermineApprovalRequirement" targetRef="ApprovalGateway" />
    <bpmn:sequenceFlow id="Flow_NoApproval_Merge" sourceRef="ApprovalGateway" targetRef="ApprovalMergeGateway" />
    <bpmn:sequenceFlow id="Flow_ManagerApproval_Task" sourceRef="ApprovalGateway" targetRef="ManagerApprovalTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalLevel == 'MANAGER'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DirectorApproval_Task" sourceRef="ApprovalGateway" targetRef="DirectorApprovalTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalLevel == 'DIRECTOR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerApproval_Decision" sourceRef="ManagerApprovalTask" targetRef="ApprovalDecisionGateway" />
    <bpmn:sequenceFlow id="Flow_DirectorApproval_Decision" sourceRef="DirectorApprovalTask" targetRef="ApprovalDecisionGateway" />
    <bpmn:sequenceFlow id="Flow_ApprovalAccepted_Merge" sourceRef="ApprovalDecisionGateway" targetRef="ApprovalMergeGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApprovalRejected_Compensate" sourceRef="ApprovalDecisionGateway" targetRef="CompensateOrder" />
    <bpmn:sequenceFlow id="Flow_ApprovalMerge_Shipping" sourceRef="ApprovalMergeGateway" targetRef="ShippingCallActivity" />
    <bpmn:sequenceFlow id="Flow_Shipping_Notification" sourceRef="ShippingCallActivity" targetRef="NotificationCallActivity" />
    <bpmn:sequenceFlow id="Flow_Notification_Complete" sourceRef="NotificationCallActivity" targetRef="CompleteOrder" />
    <bpmn:sequenceFlow id="Flow_Complete_End" sourceRef="CompleteOrder" targetRef="OrderCompleted" />
    <bpmn:sequenceFlow id="Flow_InventoryError_Compensate" sourceRef="InsufficientStockBoundary" targetRef="CompensateOrder" />
    <bpmn:sequenceFlow id="Flow_PaymentDeclined_Compensate" sourceRef="PaymentDeclinedBoundary" targetRef="CompensateOrder" />
    <bpmn:sequenceFlow id="Flow_ShipmentFailed_Compensate" sourceRef="ShipmentFailedBoundary" targetRef="CompensateOrder" />
    <bpmn:sequenceFlow id="Flow_Compensate_Reject" sourceRef="CompensateOrder" targetRef="RejectOrder" />
    <bpmn:sequenceFlow id="Flow_Reject_End" sourceRef="RejectOrder" targetRef="OrderRejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderProcessing">
    <bpmndi:BPMNPlane id="BPMNPlane_OrderProcessing" bpmnElement="order-processing">
      <bpmndi:BPMNShape id="StartOrder_di" bpmnElement="StartOrder">
        <dc:Bounds x="160" y="260" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="151" y="296" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidateOrder_di" bpmnElement="ValidateOrder">
        <dc:Bounds x="250" y="238" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReserveInventory_di" bpmnElement="ReserveInventory">
        <dc:Bounds x="420" y="238" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentCallActivity_di" bpmnElement="PaymentCallActivity">
        <dc:Bounds x="610" y="238" width="130" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentResultGateway_di" bpmnElement="PaymentResultGateway" isMarkerVisible="true">
        <dc:Bounds x="800" y="253" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="801" y="303" width="49" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DetermineApprovalRequirement_di" bpmnElement="DetermineApprovalRequirement">
        <dc:Bounds x="900" y="238" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalGateway_di" bpmnElement="ApprovalGateway" isMarkerVisible="true">
        <dc:Bounds x="1110" y="253" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1169.5" y="264" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManagerApprovalTask_di" bpmnElement="ManagerApprovalTask">
        <dc:Bounds x="1220" y="170" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DirectorApprovalTask_di" bpmnElement="DirectorApprovalTask">
        <dc:Bounds x="1220" y="335" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalDecisionGateway_di" bpmnElement="ApprovalDecisionGateway" isMarkerVisible="true">
        <dc:Bounds x="1410" y="253" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1346" y="271" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalMergeGateway_di" bpmnElement="ApprovalMergeGateway" isMarkerVisible="true">
        <dc:Bounds x="1505" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1506" y="77.5" width="48" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShippingCallActivity_di" bpmnElement="ShippingCallActivity">
        <dc:Bounds x="1625" y="238" width="130" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotificationCallActivity_di" bpmnElement="NotificationCallActivity">
        <dc:Bounds x="1815" y="238" width="155" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompleteOrder_di" bpmnElement="CompleteOrder">
        <dc:Bounds x="2030" y="238" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderCompleted_di" bpmnElement="OrderCompleted">
        <dc:Bounds x="2210" y="260" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2186" y="296" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompensateOrder_di" bpmnElement="CompensateOrder">
        <dc:Bounds x="900" y="485" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RejectOrder_di" bpmnElement="RejectOrder">
        <dc:Bounds x="1110" y="600" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderRejected_di" bpmnElement="OrderRejected">
        <dc:Bounds x="1147" y="752" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1128" y="788" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShipmentFailedBoundary_di" bpmnElement="ShipmentFailedBoundary">
        <dc:Bounds x="1672" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1650" y="336" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentDeclinedBoundary_di" bpmnElement="PaymentDeclinedBoundary">
        <dc:Bounds x="657" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="630" y="336" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InsufficientStockBoundary_di" bpmnElement="InsufficientStockBoundary">
        <dc:Bounds x="482" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="459" y="336" width="83" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Validate_di" bpmnElement="Flow_Start_Validate">
        <di:waypoint x="196" y="278" />
        <di:waypoint x="250" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_Reserve_di" bpmnElement="Flow_Validate_Reserve">
        <di:waypoint x="370" y="278" />
        <di:waypoint x="420" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reserve_Payment_di" bpmnElement="Flow_Reserve_Payment">
        <di:waypoint x="560" y="278" />
        <di:waypoint x="610" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Payment_Result_di" bpmnElement="Flow_Payment_Result">
        <di:waypoint x="740" y="278" />
        <di:waypoint x="800" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentCharged_DetermineApproval_di" bpmnElement="Flow_PaymentCharged_DetermineApproval">
        <di:waypoint x="850" y="278" />
        <di:waypoint x="900" y="278" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="854" y="253" width="43" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentNotCharged_Compensate_di" bpmnElement="Flow_PaymentNotCharged_Compensate">
        <di:waypoint x="825" y="303" />
        <di:waypoint x="825" y="525" />
        <di:waypoint x="900" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DetermineApproval_ApprovalGateway_di" bpmnElement="Flow_DetermineApproval_ApprovalGateway">
        <di:waypoint x="1050" y="278" />
        <di:waypoint x="1110" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoApproval_Merge_di" bpmnElement="Flow_NoApproval_Merge">
        <di:waypoint x="1135" y="253" />
        <di:waypoint x="1135" y="140" />
        <di:waypoint x="1505" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerApproval_Task_di" bpmnElement="Flow_ManagerApproval_Task">
        <di:waypoint x="1135" y="253" />
        <di:waypoint x="1135" y="210" />
        <di:waypoint x="1220" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DirectorApproval_Task_di" bpmnElement="Flow_DirectorApproval_Task">
        <di:waypoint x="1135" y="303" />
        <di:waypoint x="1135" y="375" />
        <di:waypoint x="1220" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerApproval_Decision_di" bpmnElement="Flow_ManagerApproval_Decision">
        <di:waypoint x="1350" y="210" />
        <di:waypoint x="1435" y="210" />
        <di:waypoint x="1435" y="253" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DirectorApproval_Decision_di" bpmnElement="Flow_DirectorApproval_Decision">
        <di:waypoint x="1350" y="375" />
        <di:waypoint x="1435" y="375" />
        <di:waypoint x="1435" y="303" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalAccepted_Merge_di" bpmnElement="Flow_ApprovalAccepted_Merge">
        <di:waypoint x="1460" y="278" />
        <di:waypoint x="1490" y="278" />
        <di:waypoint x="1490" y="140" />
        <di:waypoint x="1505" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalRejected_Compensate_di" bpmnElement="Flow_ApprovalRejected_Compensate">
        <di:waypoint x="1435" y="303" />
        <di:waypoint x="1435" y="450" />
        <di:waypoint x="970" y="450" />
        <di:waypoint x="970" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalMerge_Shipping_di" bpmnElement="Flow_ApprovalMerge_Shipping">
        <di:waypoint x="1530" y="165" />
        <di:waypoint x="1530" y="278" />
        <di:waypoint x="1625" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Shipping_Notification_di" bpmnElement="Flow_Shipping_Notification">
        <di:waypoint x="1755" y="278" />
        <di:waypoint x="1815" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Notification_Complete_di" bpmnElement="Flow_Notification_Complete">
        <di:waypoint x="1970" y="278" />
        <di:waypoint x="2030" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Complete_End_di" bpmnElement="Flow_Complete_End">
        <di:waypoint x="2150" y="278" />
        <di:waypoint x="2210" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InventoryError_Compensate_di" bpmnElement="Flow_InventoryError_Compensate">
        <di:waypoint x="500" y="336" />
        <di:waypoint x="500" y="525" />
        <di:waypoint x="900" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentDeclined_Compensate_di" bpmnElement="Flow_PaymentDeclined_Compensate">
        <di:waypoint x="675" y="336" />
        <di:waypoint x="675" y="525" />
        <di:waypoint x="900" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ShipmentFailed_Compensate_di" bpmnElement="Flow_ShipmentFailed_Compensate">
        <di:waypoint x="1690" y="336" />
        <di:waypoint x="1690" y="525" />
        <di:waypoint x="1040" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Compensate_Reject_di" bpmnElement="Flow_Compensate_Reject">
        <di:waypoint x="970" y="565" />
        <di:waypoint x="970" y="640" />
        <di:waypoint x="1110" y="640" />
      </bpmndi:BPMNEdge>
