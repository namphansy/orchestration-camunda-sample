        <dc:Bounds x="1167" y="632" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1148" y="668" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RejectOrder_di" bpmnElement="RejectOrder">
        <dc:Bounds x="970" y="460" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DetermineApprovalRequirement_di" bpmnElement="DetermineApprovalRequirement">
        <dc:Bounds x="950" y="80" width="170" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalDecisionGateway_di" bpmnElement="ApprovalDecisionGateway" isMarkerVisible="true">
        <dc:Bounds x="1515" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1451" y="193" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentConfirmationTimeoutBoundary_di" bpmnElement="PaymentConfirmationTimeoutBoundary">
        <dc:Bounds x="857" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="833" y="336" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentDeclinedBoundary_di" bpmnElement="PaymentDeclinedBoundary">
        <dc:Bounds x="678" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="651" y="336" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InsufficientStockBoundary_di" bpmnElement="InsufficientStockBoundary">
        <dc:Bounds x="480" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="457" y="336" width="83" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Validate_di" bpmnElement="Flow_Start_Validate">
        <di:waypoint x="196" y="278" />
        <di:waypoint x="250" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_Reserve_di" bpmnElement="Flow_Validate_Reserve">
        <di:waypoint x="370" y="278" />
        <di:waypoint x="430" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reserve_Charge_di" bpmnElement="Flow_Reserve_Charge">
        <di:waypoint x="570" y="278" />
        <di:waypoint x="630" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Charge_WaitPaymentConfirmation_di" bpmnElement="Flow_Charge_WaitPaymentConfirmation">
        <di:waypoint x="760" y="278" />
        <di:waypoint x="790" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentConfirmation_PaymentResult_di" bpmnElement="Flow_PaymentConfirmation_PaymentResult">
        <di:waypoint x="960" y="278" />
        <di:waypoint x="1010" y="278" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentConfirmationTimeout_MarkTimeout_di" bpmnElement="Flow_PaymentConfirmationTimeout_MarkTimeout">
        <di:waypoint x="875" y="336" />
        <di:waypoint x="875" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MarkPaymentTimedOut_Reject_di" bpmnElement="Flow_MarkPaymentTimedOut_Reject">
        <di:waypoint x="875" y="630" />
        <di:waypoint x="875" y="570" />
        <di:waypoint x="1035" y="570" />
        <di:waypoint x="1035" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentCharged_DetermineApproval_di" bpmnElement="Flow_PaymentCharged_DetermineApproval">
        <di:waypoint x="1035" y="253" />
        <di:waypoint x="1035" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1000" y="241" width="43" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentNotCharged_Reject_di" bpmnElement="Flow_PaymentNotCharged_Reject">
        <di:waypoint x="1035" y="303" />
        <di:waypoint x="1035" y="460" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1114" y="480" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DetermineApproval_ApprovalGateway_di" bpmnElement="Flow_DetermineApproval_ApprovalGateway">
        <di:waypoint x="1120" y="120" />
        <di:waypoint x="1185" y="120" />
        <di:waypoint x="1185" y="253" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoApproval_Fork_di" bpmnElement="Flow_NoApproval_Fork">
        <di:waypoint x="1210" y="278" />
        <di:waypoint x="1625" y="278" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1389" y="253" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerApproval_Task_di" bpmnElement="Flow_ManagerApproval_Task">
        <di:waypoint x="1185" y="253" />
        <di:waypoint x="1185" y="120" />
        <di:waypoint x="1265" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1155" y="174" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DirectorApproval_Task_di" bpmnElement="Flow_DirectorApproval_Task">
        <di:waypoint x="1185" y="303" />
        <di:waypoint x="1185" y="388" />
        <di:waypoint x="1280" y="388" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1158" y="336" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
